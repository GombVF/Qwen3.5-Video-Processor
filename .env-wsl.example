VISUAL_HOST=127.0.0.1
VISUAL_PORT=8001
VISUAL_MEDIA_ROOT=/mnt/e/personal-media-search/data/media

VISUAL_QWEN_MODEL_ID=/mnt/e/Trabajo/Proyectos/Qwen/Qwen3.5-4B
VISUAL_QWEN_DTYPE=bfloat16
VISUAL_QWEN_ATTN_IMPLEMENTATION=sdpa
VISUAL_QWEN_LOCAL_FILES_ONLY=true
VISUAL_QWEN_ENABLE_THINKING=false
VISUAL_QWEN_MAX_CONCURRENCY=1
VISUAL_QWEN_PROMPT_VERSION=visual-analysis-qwen35-v3
VISUAL_QWEN_SCHEMA_VERSION=5.0

# WSL/ROCm performance policy. The service explicitly binds Qwen3.5's gated
# delta-rule calls to FLA and fails at startup if FLA cannot be selected.
VISUAL_QWEN_FORCE_FLA_BINDING=true
VISUAL_QWEN_REQUIRE_FLA=true

VISUAL_ANALYSIS_LANGUAGE=Spanish
VISUAL_ANALYSIS_MODE=SEMANTIC_AND_OCR

# Retry only transient FFmpeg/swscale EAGAIN failures. Invalid or unsupported
# media still fails immediately.
VISUAL_VIDEO_DECODE_MAX_ATTEMPTS=2
VISUAL_VIDEO_DECODE_RETRY_DELAY_MS=250

# Semantic and overview passes use the project's explicit PyAV sampler. Do not
# set FORCE_QWENVL_VIDEO_READER; qwen-vl-utils receives in-memory frames and
# does not open video files.

